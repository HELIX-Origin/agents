# Normalize line endings across platforms so agents on Windows, Linux, and
# macOS see byte-identical files and the working tree never churns.
# This overrides core.autocrlf for every matched path.
* text=auto eol=lf

# Explicit text types
*.md        text eol=lf
*.jsonc     text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.ps1       text eol=lf
*.svg       text eol=lf

# Windows batch scripts must keep CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf

# Binary types (never convert)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.icns      binary
*.pdf       binary
*.zip       binary
