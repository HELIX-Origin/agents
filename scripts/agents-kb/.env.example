# ==============================================================================
# HELIX-Origin Agent Ecosystem & Scaffolding Configuration (.env.example)
# Copy this file to .env to auto-configure the kb-scaffold CLI without passing
# manual flags on every invocation.
#
# Usage:
#   node kb-scaffold.ts --path ../../projects/my-app
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project & Engine Settings
# ------------------------------------------------------------------------------
# Available types: tauri-desktop, jekyll-theme, node-ts-cli, rust-library, docs-site
SCAFFOLD_TYPE=tauri-desktop

# Target project directory path (relative or absolute)
SCAFFOLD_PATH=../../projects/my-app

# Project name (defaults to target folder basename if omitted)
SCAFFOLD_PROJECT_NAME=my-app

# License type (default: MIT; GitHub projects default to MIT, org-authored BSD-3-Clause, etc.)
SCAFFOLD_LICENSE=MIT

# Optional third-party service name (used in TOS.md if scaffolded)
SCAFFOLD_SERVICE_NAME=Steam Web API

# ------------------------------------------------------------------------------
# 2. Optional Project Links (Opt-in)
# ------------------------------------------------------------------------------
# These are intentionally blank by default. Fill in only what your project uses;
# every link you leave blank is omitted from the generated files entirely, so no
# organization-specific domain is ever hardcoded into a scaffolded project.

# Public documentation site (e.g. https://docs.example.com)
SCAFFOLD_DOCS_URL=

# Technical wiki (e.g. https://wiki.example.com)
SCAFFOLD_WIKI_URL=

# Source repository URL (enables Releases / Issues / Security / compare links)
SCAFFOLD_REPO_URL=

# Repository slug for badges (owner/repo, e.g. octocat/hello-world)
SCAFFOLD_REPO_SLUG=

# Organization or owner homepage
SCAFFOLD_ORG_URL=

# Organization name (used as the CITATION.cff author)
SCAFFOLD_ORG_NAME=

# Portal / landing page
SCAFFOLD_PORTAL_URL=

# Discord invite URL (opt-in; enabled only when set)
SCAFFOLD_DISCORD_URL=

# Enable GitHub Discussions links (true/false; only if the repo has them)
SCAFFOLD_DISCUSSIONS=false

# ------------------------------------------------------------------------------
# 3. Tracking Ledgers Selection (Optional)
# ------------------------------------------------------------------------------
# By default, ONLY AGENTS.md is created. You can optionally scaffold any combination of:
#   plan, handoff, bugs, todo, roadmap (or "all" for all tracking ledgers)
# Example: SCAFFOLD_TRACKING=plan,handoff,bugs,todo
SCAFFOLD_TRACKING=plan,handoff,bugs,todo

# ------------------------------------------------------------------------------
# 4. GitHub Repository Community Health Files (Optional)
# ------------------------------------------------------------------------------
# By default, health files are not created. You can optionally scaffold any combination of:
#   CODE_OF_CONDUCT.md, PRIVACY.md, SECURITY.md, SUPPORT.md, CHANGELOG.md,
#   GOVERNANCE.md, CONTRIBUTING.md, CITATION.cff, TOS.md
# (or "all" for all community health files)
SCAFFOLD_HEALTH=CODE_OF_CONDUCT.md,PRIVACY.md,SECURITY.md,SUPPORT.md,CHANGELOG.md,GOVERNANCE.md,CONTRIBUTING.md

# ------------------------------------------------------------------------------
# 5. Execution Flags
# ------------------------------------------------------------------------------
# Set to true to preview actions without writing to disk
SCAFFOLD_DRY_RUN=false

# Set to true to force overwrite existing files (default: false)
SCAFFOLD_FORCE=false

# ------------------------------------------------------------------------------
# 6. Direct Command Line Pass-through (Alternative)
# ------------------------------------------------------------------------------
# Optionally pass the exact scaffold command string here. If provided, these tokens
# are parsed as baseline CLI arguments.
# SCAFFOLD_ARGS="--type tauri-desktop --license MIT --tracking plan,handoff,bugs,todo --health CODE_OF_CONDUCT.md,PRIVACY.md,SECURITY.md,SUPPORT.md,CHANGELOG.md,GOVERNANCE.md,CONTRIBUTING.md"
