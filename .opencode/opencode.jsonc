{
  "$schema": "https://opencode.ai/config.json",

  // ── Plugins ────────────────────────────────────────────────────────────────
  // DCP = dynamic context pruning (see dcp.jsonc). plannotator = review pane.
  // NOTE: the pinned client here is 1.18.x; plugins must stay compatible with it.
  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    "@plannotator/opencode@latest"
  ],

  // ── Instructions ───────────────────────────────────────────────────────────
  "instructions": [
    "AGENTS.md",
    "https://raw.githubusercontent.com/JRedeker/opencode-shell-strategy/trunk/shell_strategy.md"
  ],

  // ── Permissions ────────────────────────────────────────────────────────────
  // Read/explore/network tools auto-approve so the agent stops stalling on
  // prompts. Every git-mutating or destructive shell command stays gated with
  // "ask" — ORDER IS LOAD-BEARING: the broad allows come FIRST and the gated
  // rules come LAST, because the last matching rule wins. Moving a broad allow
  // below a git rule would silently un-gate it and break workspace invariant #1
  // (no unauthorized git operations).
  "permissions": [
    { "action": "read",               "resource": "*", "effect": "allow" },
    { "action": "edit",               "resource": "*", "effect": "allow" },
    { "action": "glob",               "resource": "*", "effect": "allow" },
    { "action": "grep",               "resource": "*", "effect": "allow" },
    { "action": "webfetch",           "resource": "*", "effect": "allow" },
    { "action": "websearch",          "resource": "*", "effect": "allow" },
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "skill",              "resource": "*", "effect": "allow" },
    { "action": "subagent",           "resource": "*", "effect": "allow" },
    { "action": "question",           "resource": "*", "effect": "allow" },

    // Read-only inspection commands.
    { "action": "shell", "resource": "git status *",  "effect": "allow" },
    { "action": "shell", "resource": "git diff *",    "effect": "allow" },
    { "action": "shell", "resource": "git log *",     "effect": "allow" },
    { "action": "shell", "resource": "git show *",    "effect": "allow" },
    { "action": "shell", "resource": "git ls-files *","effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "gh issue view *",   "effect": "allow" },
    { "action": "shell", "resource": "gh issue list *",   "effect": "allow" },
    { "action": "shell", "resource": "gh pr view *",      "effect": "allow" },
    { "action": "shell", "resource": "gh pr list *",      "effect": "allow" },
    { "action": "shell", "resource": "gh release view *", "effect": "allow" },
    { "action": "shell", "resource": "gh release list *", "effect": "allow" },
    { "action": "shell", "resource": "gh repo view *",    "effect": "allow" },
    { "action": "shell", "resource": "magick *",          "effect": "allow" },

    // Everything else runs, but prompts before executing.
    { "action": "shell", "resource": "*", "effect": "ask" },

    // Gated: repository-mutating git (workspace invariant #1). Never relax
    // these; the user authorizes exact operations per repository, per session.
    { "action": "shell", "resource": "git add *",           "effect": "ask" },
    { "action": "shell", "resource": "git commit *",        "effect": "ask" },
    { "action": "shell", "resource": "git push *",          "effect": "ask" },
    { "action": "shell", "resource": "git pull *",          "effect": "ask" },
    { "action": "shell", "resource": "git fetch *",         "effect": "ask" },
    { "action": "shell", "resource": "git merge *",         "effect": "ask" },
    { "action": "shell", "resource": "git rebase *",        "effect": "ask" },
    { "action": "shell", "resource": "git reset *",         "effect": "ask" },
    { "action": "shell", "resource": "git revert *",        "effect": "ask" },
    { "action": "shell", "resource": "git stash *",         "effect": "ask" },
    { "action": "shell", "resource": "git checkout *",      "effect": "ask" },
    { "action": "shell", "resource": "git switch *",        "effect": "ask" },
    { "action": "shell", "resource": "git clean *",         "effect": "ask" },
    { "action": "shell", "resource": "git tag *",           "effect": "ask" },
    { "action": "shell", "resource": "git branch *",        "effect": "ask" },
    { "action": "shell", "resource": "git mv *",            "effect": "ask" },
    { "action": "shell", "resource": "git restore *",       "effect": "ask" },
    { "action": "shell", "resource": "git worktree *",      "effect": "ask" },
    { "action": "shell", "resource": "gh issue create *",   "effect": "ask" },
    { "action": "shell", "resource": "gh issue close *",    "effect": "ask" },
    { "action": "shell", "resource": "gh issue edit *",     "effect": "ask" },
    { "action": "shell", "resource": "gh pr create *",      "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *",       "effect": "ask" },
    { "action": "shell", "resource": "gh release create *", "effect": "ask" },
    { "action": "shell", "resource": "rm *",                "effect": "ask" },
    { "action": "shell", "resource": "sudo *",              "effect": "ask" }
  ],

  "formatter": true,

  "compaction": {
    "auto": true
  }
}
