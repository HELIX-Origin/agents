{
  "$schema": "https://opencode.ai/config.json",

  "model": "opencode/beam-free",

  "instructions": [".opencode/instructions/*.md"],

  "compaction": {
    "auto": true,
    "keep": { "tokens": 20000 },
    "buffer": 24000
  },
  "tool_output": {
    "max_lines": 1500,
    "max_bytes": 51200
  },

  "experimental": {
    "todo": true,
    "subagent_depth": 1,
    "background_compaction": true
  },

  "plugins": [
    "projects/depressurizer/.opencode/plugins",
    "projects/ffxiv-config/.opencode/plugins",
    "projects/nh-reader/.opencode/plugins",
    "projects/theme-toolkit/.opencode/plugins",
    "projects/windhawk-themes/.opencode/plugins",
    "projects/windows-game-explorer/.opencode/plugins"
  ]
}
